# =============================================================================
# Шаблон переменных окружения.
#
# Скопируйте этот файл в .env (cp .env.example .env) и заполните нужные значения.
# .env в .gitignore — в репозиторий он не попадает. Права: chmod 600 .env
#
# Переменные, уже заданные в окружении (export, systemd, Docker), приоритетнее
# этого файла. .env читается для любой точки входа: python run.py, gunicorn wsgi:app,
# flask db, python -m inference.server.
# =============================================================================

# --- Flask-панель (vision_app) ------------------------------------------------

# Секретный ключ (сессии, CSRF). В проде ОБЯЗАТЕЛЬНО задайте свой — длинная
# случайная строка. Без него приложение не стартует (в тестах и debug
# FLASK_DEBUG=1 подставляется локальный дефолт).
# FLASK_SECRET_KEY=

# Мастер-ключ Fernet, которым шифруются API-ключи провайдеров в БД. Нужен, только
# если вы сохраняете ключи провайдеров (Gemini/Anthropic) на странице статуса.
# Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Ротация: несколько ключей через запятую — «новый,старый».
# ВНИМАНИЕ: потеряете ключ — сохранённые API-ключи не расшифруются (придётся ввести заново).
# VISION_CREDENTIALS_KEY=

# Строка подключения SQLAlchemy
DATABASE_URL=sqlite:///db.sqlite3

# Куда сохраняются загруженные изображения
UPLOAD_FOLDER=./media

# Максимальный размер запроса (байты). 50 МБ
MAX_CONTENT_LENGTH=52428800

# Адрес inference/server.py
VISION_API_BASE_URL=http://127.0.0.1:6769

# Таймаут запроса к /analyze (сек)
VISION_API_TIMEOUT=500

# Часовой пояс отображения дат
APP_TIMEZONE=Asia/Aqtobe

# Создавать/обновлять таблицы при старте (1) / только через flask db (0)
AUTO_CREATE_DB=1

# Cookie только по HTTPS (1)
SESSION_COOKIE_SECURE=0

# Сколько последних вложений чата передаётся модели картинкой (не меньше 4)
CHAT_CONTEXT_IMAGES=6

# Фоновая обработка очереди
QUEUE_WORKER_ENABLED=1
QUEUE_WORKERS=1
QUEUE_POLL_SECONDS=5
QUEUE_MAX_FILES_PER_UPLOAD=20
QUEUE_MAX_PENDING_PER_USER=30
QUEUE_MAX_PENDING_TOTAL=200

# Поиск «по смыслу» в чате (vector_search)
EMBEDDING_MIN_SIMILARITY=0.28
EMBEDDING_RELATIVE_MARGIN=0.15
EMBEDDING_SCAN_LIMIT=5000
EMBEDDING_MEMORY_CACHE=1

# Автофолбэк на другой бэкенд при недоступности/5xx (выключено: 0)
VISION_API_FALLBACK=1

# Куда пишутся логи приложения
# VISION_LOG_DIR=logs

# Где искать inference/server.py для авто-запуска из run.py
# VISION_ANALYZER_DIR=inference

# Каким python запускать inference/server.py (venv рядом с inference/, по умолчанию)
# VISION_ANALYZER_PYTHON=

# =============================================================================
# Сервер анализа (inference/)
# =============================================================================

# Бэкенд по умолчанию (vllm / ollama / gemini / anthropic)
VISION_ANALYZER_BACKEND=vllm

# Ollama
VISION_ANALYZER_OLLAMA_HOST=http://127.0.0.1:11434

# vLLM (OpenAI-совместимый)
VISION_ANALYZER_VLLM_URL=http://host.docker.internal:8000/v1

# Gemini
VISION_ANALYZER_GEMINI_MODEL=gemini-2.5-flash
# Порог фильтров безопасности (BLOCK_NONE, BLOCK_ONLY_HIGH, …)
# VISION_ANALYZER_GEMINI_SAFETY=
# Базовый URL API (свой прокси)
# VISION_ANALYZER_GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Anthropic
VISION_ANALYZER_ANTHROPIC_MODEL=claude-sonnet-5-5
VISION_ANALYZER_ANTHROPIC_MAX_TOKENS=16000
VISION_ANALYZER_ANTHROPIC_VERSION=2023-06-01
# Базовый URL API (свой прокси)
# VISION_ANALYZER_ANTHROPIC_API_BASE=https://api.anthropic.com/v1

# Параметр одного провайдера, например:
#   VISION_ANALYZER_VLLM_TEMPERATURE=0.6
#   VISION_ANALYZER_VLLM_THINK_BUDGET=2048
# Старые общие имена (действуют на все бэкенды, где есть параметр):
# VISION_ANALYZER_TEMPERATURE / _TOP_P / _TOP_K / _SEED / _NUM_CTX / _NUM_PREDICT / _THINK / _THINK_BUDGET

# Облачный фолбэк в цепочке (1 = включён)
VISION_ANALYZER_CLOUD_FALLBACK=1

# Анализ ссылок на посты (картинки из ссылок)
VISION_ANALYZER_LINKS_ENABLED=1
VISION_ANALYZER_LINKS_MAX=10
VISION_ANALYZER_LINKS_MAX_IMAGES=4
# Вайтсайт на размер одной картинки (20 МБ)
# VISION_ANALYZER_LINKS_MAX_IMAGE_BYTES=20971520
VISION_ANALYZER_LINKS_TIMEOUT=45
# Токены куки для доступа к закрытому контенту
# VISION_ANALYZER_LINKS_COOKIES=
# Разрешить запросы на приватные/внутренние адреса (0)
VISION_ANALYZER_LINKS_ALLOW_PRIVATE=0

# Эмбеддинги текста
VISION_ANALYZER_EMBEDDING_ENABLED=1
# VISION_ANALYZER_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
VISION_ANALYZER_EMBEDDING_MAX_CHARS=8000

# Статус /health: таймаут пинга (сек) и время кэша ответа
VISION_ANALYZER_HEALTH_PROBE_TIMEOUT=3
VISION_ANALYZER_HEALTH_CACHE_OK_TTL=3
VISION_ANALYZER_HEALTH_CACHE_FAIL_TTL=15
