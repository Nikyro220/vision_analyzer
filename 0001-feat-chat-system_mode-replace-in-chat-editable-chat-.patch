+        # ведём себя как раньше и просто передаём system как есть (может быть None).
+        system_prompt = (
+            prompt.get_chat_system_prompt(resolved_lang or config._current_lang(), overrides["system"])
+            if prompt is not None
+            else overrides["system"]
+        )
 
