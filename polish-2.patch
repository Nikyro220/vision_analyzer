@@ -0,0 +1,38 @@
+{% extends "base.html" %}
+{% block title %}История · {{ target.username }}{% endblock %}
+{% block content %}
+<div class="page-header">
+    <h1>История: {{ target.username }}</h1>
+    <p class="page-sub">Завершённых анализов: {{ page.total }} · <a href="{{ url_for('panel.user_detail', pk=target.id) }}">← К профилю</a></p>
+</div>
+
+{% if page.items %}
+<div class="table-wrap">
+    <table class="data-table">
+        <thead>
+            <tr>
+                <th>Файл</th>
+                <th>Риск</th>
+                <th>Проверка</th>
+                <th>Бэкенд</th>
+                <th>Дата</th>
+            </tr>
+        </thead>
+        <tbody>
+            {% for item in page.items %}
+            <tr class="row-clickable" data-href="{{ url_for('analyzer.result_detail', pk=item.id) }}">
+                <td><span class="cell-file"><img class="row-thumb" src="{{ url_for('analyzer.thumb', filename=item.image_path) }}" alt="" loading="lazy" width="44" height="44" onerror="this.style.visibility='hidden'"><span class="cell-file-name">{{ (item.original_name or '—')|trunc(40) }}</span></span></td>
+                <td><span class="risk-pill risk-pill-{{ item.risk_level }}">{{ item.risk_level_display }}</span>{% if item.is_error %} <span class="tag tag-warn">ошибка</span>{% endif %}</td>
+                <td>{% if item.needs_human_review %}<span class="tag tag-warn">да</span>{% else %}<span class="tag">нет</span>{% endif %}</td>
+                <td>{{ item.backend or '—' }}</td>
+                <td>{{ item.created_at|localdt('%d.%m.%Y %H:%M') }}</td>
+            </tr>
+            {% endfor %}
+        </tbody>
+    </table>
+</div>
+{% include "partials/pagination.html" %}
+{% else %}
+<p class="empty-hint">У этого пользователя нет завершённых анализов.</p>
+{% endif %}
+{% endblock %}
diff --git a/vision_app/thumbs.py b/vision_app/thumbs.py
new file mode 100644
index 0000000..eb07196
--- /dev/null
+++ b/vision_app/thumbs.py
@@ -0,0 +1,62 @@
+"""Миниатюры для списков истории: маленькие JPEG, создаются при первом запросе и кэшируются на диске.
+
+Кэш лежит в UPLOAD_FOLDER/thumbs/... и повторяет структуру uploads/..., поэтому работает и для
+уже загруженных раньше файлов. Удаляются миниатюры вместе с оригиналом (см. history.py).
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import uuid
+from pathlib import Path
+
+from PIL import Image, ImageOps
+
+log = logging.getLogger("vision_app.thumbs")
+
+THUMB_SIZE = 96  # px; в интерфейсе показываем 36-44 px, запас под retina-экраны
+THUMB_QUALITY = 80
+THUMBS_DIR = "thumbs"
+
+
+def thumb_rel(image_rel: str) -> str:
+    """uploads/2026/09/28/abc.png -> thumbs/uploads/2026/09/28/abc.jpg"""
+    stem = image_rel.rsplit(".", 1)[0] if "." in Path(image_rel).name else image_rel
+    return f"{THUMBS_DIR}/{stem}.jpg"
+
+
+def ensure_thumb(root: Path, image_rel: str) -> Path | None:
+    """Путь к миниатюре (создаёт при необходимости). None — если исходник недоступен или не читается."""
+    root = root.resolve()
+    src = (root / image_rel).resolve()
+    dst = (root / thumb_rel(image_rel)).resolve()
+    thumbs_root = root / THUMBS_DIR
+    if root not in src.parents or thumbs_root not in dst.parents:  # защита от «../»
+        return None
+    if dst.is_file():
+        return dst
+    if not src.is_file():
+        return None
+
+    tmp = dst.with_name(f"{dst.stem}.{uuid.uuid4().hex}.tmp")
+    try:
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        with Image.open(src) as im:
+            im.draft("RGB", (THUMB_SIZE * 2, THUMB_SIZE * 2))  # для JPEG декодируем сразу уменьшенным
+            im = ImageOps.exif_transpose(im)
+            if im.mode in ("P", "LA", "PA") or "transparency" in im.info:
+                im = im.convert("RGBA")
+            if im.mode == "RGBA":  # прозрачность -> белая подложка, иначе в JPEG будет чёрный фон
+                bg = Image.new("RGB", im.size, (255, 255, 255))
+                bg.paste(im, mask=im.getchannel("A"))
+                im = bg
+            im = ImageOps.fit(im.convert("RGB"), (THUMB_SIZE, THUMB_SIZE), Image.Resampling.LANCZOS)
+            im.save(tmp, "JPEG", quality=THUMB_QUALITY, optimize=True)
+        os.replace(tmp, dst)  # атомарно: параллельный запрос не увидит недописанный файл
+        return dst
+    except (OSError, ValueError, Image.DecompressionBombError) as exc:
+        log.warning("Не удалось сделать миниатюру для %s: %s", image_rel, exc)
+        return None
+    finally:
+        tmp.unlink(missing_ok=True)
